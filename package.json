{
  "name": "openforms",
  "version": "4.1.0-alpha.0",
  "description": "Open Forms",
  "main": "src/static/openforms/js/openforms.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "test": "TZ=Europe/Amsterdam vitest --project=unit",
    "test:storybook": "test-storybook",
    "build": "vite build",
    "build:typecheck": "tsc --noEmit",
    "start": "vite dev",
    "makemessages": "formatjs extract",
    "compilemessages": "formatjs compile",
    "format": "prettier --write 'src/openforms/{js,scss}/**/*.{js,scss,mdx}'",
    "checkformat": "prettier --check 'src/openforms/{js,scss}/**/*.{js,scss,mdx}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --webpack-stats-json",
    "postinstall": "patch-package"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/open-formulieren/open-forms.git"
  },
  "author": "Maykin",
  "license": "EUPL-1.2",
  "homepage": "https://www.maykin.nl",
  "dependencies": {
    "@formatjs/cli": "^6.6.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@open-formulieren/design-tokens": "^1.2.0",
    "@open-formulieren/formio-builder": "^2.0.0-alpha.2",
    "@open-formulieren/formio-renderer": "^2.0.2",
    "@open-formulieren/monaco-json-editor": "^0.3.0",
    "@tinymce/tinymce-react": "^4.3.2",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "classnames": "^2.3.1",
    "design-token-editor": "^0.6.0",
    "django-cookie-consent": "^1.0.0",
    "feelin": "^3.1.0",
    "flatpickr": "^4.6.9",
    "formik": "^2.2.9",
    "immer": "^9.0.6",
    "json-logic-js": "^2.0.1",
    "leaflet": "^1.7.1",
    "lodash-es": "^4.18.1",
    "paper-css": "^0.4.1",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-modal": "^3.16.1",
    "react-select": "^5.8.0",
    "react-tabs": "^6.0.2",
    "react-use": "^17.2.4",
    "state-pool": "^0.7.1",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-react": "^7.13.13",
    "@bbt/bem": "^1.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@utrecht/heading-2-css": "^2.0.1",
    "@utrecht/link-list-css": "^3.0.1",
    "@utrecht/page-content-css": "^2.0.1",
    "@utrecht/page-css": "^2.0.1",
    "@utrecht/page-footer-css": "^3.0.1",
    "@utrecht/page-header-css": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-formatjs": "^10.5.1",
    "bootstrap": "~4.6.0",
    "msw": "^2.6.5",
    "msw-storybook-addon": "^2.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.0",
    "react-select-event": "^5.5.1",
    "sass": "^1.32.12",
    "semver": "^7.3.7",
    "storybook": "10.6.1",
    "storybook-react-intl": "^10.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "yargs": "^17.3.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  },
  "msw": {
    "workerDirectory": "public"
  },
  "prettier": {
    "$schema": "http://json.schemastore.org/prettierrc",
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "bracketSameLine": false,
    "jsxSingleQuote": false,
    "printWidth": 100,
    "proseWrap": "always",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "importOrder": [
      "^((components|hooks|utils)/(.*))$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  }
}
